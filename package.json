{
  "name": "imbehind",
  "version": "0.0.0",
  "description": "An OpenAI Chat Completions compatible API server where a human writes the replies.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "imbehind": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run --coverage",
    "knip": "knip",
    "deps": "depcruise src --config .dependency-cruiser.cjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run knip && npm run deps",
    "audit": "npm audit",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "18.5.0",
    "knip": "6.41.0",
    "openai": "7.32.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
